# ==============================================================================
# Alert Disaster Restoration Field Scoping Copilot Environment Configuration
# ==============================================================================

# Gemini Multimodal Live API
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY

LIVE_MODEL=gemini-2.0-flash-exp
LIVE_VOICE=Charon

# Google Maps Platform (Places API New, Maps JavaScript API)
# Required for live property address auto-populate, geocoding & mapping
# Option A (Instant Free Prototype): https://mapsplatform.google.com/maps-demo-key
# Option B (Production): https://console.cloud.google.com/google/maps-apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Optional Telemetry
OTEL_SDK_DISABLED=true

# ==============================================================================
# Firebase client (browser) — read by lib/firebase.ts
# ==============================================================================
# All six NEXT_PUBLIC_FIREBASE_* values are REQUIRED. The app throws a clear
# error at startup listing every missing variable rather than falling back to a
# hardcoded production project. Find these in the Firebase console:
# Project settings → General → Your apps → Web app → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Named Firestore database id (Firestore → Databases). Used by the client Firestore SDK.
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=

# ==============================================================================
# Firebase Admin (server) — for ID token verification on /api routes
# ==============================================================================
# Read by lib/auth.ts. These three fields come from the Firebase service-account
# JSON (Project settings → Service accounts → Generate new private key):
#   FIREBASE_ADMIN_PROJECT_ID   → JSON field "project_id"
#   FIREBASE_ADMIN_CLIENT_EMAIL → JSON field "client_email"
#   FIREBASE_ADMIN_PRIVATE_KEY  → JSON field "private_key" (include the full
#                                 "-----BEGIN PRIVATE KEY-----" block)
# Keep these server-only; never prefix any of them with NEXT_PUBLIC_.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=