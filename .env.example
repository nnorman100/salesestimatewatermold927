# ==============================================================================
# Alert Disaster Restoration Field Scoping Copilot Environment Configuration
# ==============================================================================

# Gemini Multimodal Live API
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY

LIVE_MODEL=gemini-2.0-flash-exp
LIVE_VOICE=Charon

# Google Maps Platform (Places API New, Maps JavaScript API)
# Required for live property address auto-populate, geocoding & mapping
# Option A (Instant Free Prototype): https://mapsplatform.google.com/maps-demo-key
# Option B (Production): https://console.cloud.google.com/google/maps-apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Optional Telemetry & Firestore
OTEL_SDK_DISABLED=true
